#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args, **options)
  system(*args, **options, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # pnpm は実行したディレクトリの packageManager で版を選ぶので、--dir ではなく chdir で入る
  puts "\n== Building React dashboard =="
  system! "pnpm", "install", "--frozen-lockfile", chdir: "dashboard"
  system!({ "VITE_BASE_PATH" => "/dashboard/" }, "pnpm", "build", chdir: "dashboard")

  puts "\n== Installing storefront dependencies =="
  system! "pnpm", "install", "--frozen-lockfile", chdir: "storefront"

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  # ストア画面が Store API を呼ぶための publishable API キーを .env.local に書く
  env_file = "storefront/.env.local"
  unless File.exist?(env_file)
    puts "\n== Writing #{env_file} =="
    key = `bin/rails spree:cli:ensure_api_key`.strip
    if $?.success? && key.start_with?("pk_")
      File.write(env_file, <<~ENV)
        SPREE_API_URL=http://localhost:3000
        SPREE_PUBLISHABLE_KEY=#{key}
        NEXT_PUBLIC_DEFAULT_COUNTRY=us
        NEXT_PUBLIC_DEFAULT_LOCALE=en
        NEXT_PUBLIC_SITE_URL=http://localhost:3001
      ENV
    else
      puts "publishable API キーを作れなかった。db:seed のあとに bin/setup --skip-server をもう一度実行する"
    end
  end

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
